// The lyrics editors and the AI settings, styled like `dialog_stylesheet` in lrcplayer.py:
//
// - `SyncDialog`: Ctrl+T, the tap-to-sync editor (`LyricsSyncDialog`).
// - `TranslationDialog`: Ctrl+Shift+T, Add translation (`TranslationDialog`).
// - `AiSettingsDialog`: View ▾ → AI alignment… (`AiSettingsDialog`).
// - `AnswerDialog`: "Show model's answer", a message box with details.
//
// Rust (`src/editors.rs`) holds the state and the rules; these only show it.

import { ScrollView, TextEdit, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PushButton, TipBox } from "widgets.slint";

// One row of the sync list (`_refresh`).
export struct SyncRowData {
    cursor: bool,
    time: string,
    // 0: not stamped, 1: in order, 2: earlier than a line above it.
    time-look: int,
    main: string,
    sub: string,
    // 0: the ▶ line, 1: not stamped yet, 2: stamped.
    look: int,
    selected: bool,
}

// One row of the review table.
export struct TranslationRowData {
    time: string,
    sung: string,
    sung-tip: string,
    translation: string,
    // No translation: the row is tinted.
    empty: bool,
    // Same as the sung line, so it won't be saved: drawn faint.
    repeat: bool,
    tip: string,
}

// Label roles of `dialog_stylesheet`.
component Muted inherits Text {
    color: Theme.muted;
    font-size: 13px;
    wrap: word-wrap;
}

component Help inherits Text {
    color: Theme.faint;
    font-size: 11px;
    wrap: word-wrap;
}

component Status inherits Text {
    in property <bool> error;
    color: root.error ? Theme.error : Theme.status;
    font-size: 13px;
    wrap: word-wrap;
    vertical-alignment: center;
}

// A QProgressBar of 6 px: a share of the groove, or a sliding block while busy.
component Progress inherits Rectangle {
    in property <bool> known;
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.groove;
    clip: true;
    property <float> phase: mod(animation-tick() / 1500ms, 1);
    Rectangle {
        x: root.known ? 0 : (root.width * 1.3) * root.phase - root.width * 0.3;
        width: root.known ? root.width * clamp(root.value, 0, 1) : root.width * 0.3;
        height: 100%;
        border-radius: 3px;
        background: Theme.accent;
    }
}

// QCheckBox with the app's indicator.
component CheckBox {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: 22px;
    HorizontalLayout {
        spacing: 9px;
        alignment: start;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - 16px) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? Theme.primary-border : touch.has-hover ? Theme.accent : Theme.btn-border;
            background: root.checked ? Theme.primary : Theme.surface;
            if root.checked: Text {
                text: "✓";
                font-size: 12px;
                font-weight: 700;
                color: Theme.primary-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.text;
            color: Theme.text-soft;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// =======================================================================================
// Sync lyrics
// =======================================================================================

export component SyncDialog inherits Window {
    in property <string> window-title <=> root.title;
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 860px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 420px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";

    in property <int> page;
    in-out property <string> input-text;
    in property <bool> use-shown-enabled;
    in property <string> warn-text;
    in property <bool> track-ok: true;
    in property <[SyncRowData]> rows;
    in property <string> progress-text;
    in property <string> time-text: "00:00.00";
    in property <bool> playing;
    in property <string> status-text;
    in property <string> help-text;
    in property <string> intro-text;
    in-out property <length> list-scroll;
    out property <length> list-height;

    callback load-file();
    callback use-shown();
    callback start-syncing();
    callback restart();
    callback seek-relative(int);
    callback toggle-play();
    callback stamp();
    callback undo();
    callback save();
    callback edit-text();
    callback add-break();
    callback preview();
    callback copy-lrc();
    callback embed();
    callback move-cursor(int);
    callback nudge(int);
    callback row-clicked(int);
    callback row-double-clicked(int);
    callback close-asked();

    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-keys() {
        keys.focus();
    }

    // "Copy LRC": through a hidden text field, which uses the same clipboard as Ctrl+C.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }

    clip := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-asked();
                return accept;
            }
            if root.page != 1 {
                return reject;
            }
            let ctrl = event.modifiers.control;
            let none = !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta;
            if event.text == Key.Return {
                root.stamp();
                return accept;
            }
            if event.text == Key.Backspace || (ctrl && event.text.to-lowercase() == "z") {
                root.undo();
                return accept;
            }
            if ctrl && event.text.to-lowercase() == "s" {
                root.save();
                return accept;
            }
            if event.text == " " {
                root.toggle-play();
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.seek-relative(-5000);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.seek-relative(5000);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-cursor(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move-cursor(1);
                return accept;
            }
            if event.text == Key.Home {
                root.restart();
                return accept;
            }
            if none && event.text.to-lowercase() == "b" {
                root.add-break();
                return accept;
            }
            if event.text == "[" {
                root.nudge(-100);
                return accept;
            }
            if event.text == "]" {
                root.nudge(100);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            // ---------- Page 0: the lyrics text ----------
            if root.page == 0: VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                Muted {
                    text: root.intro-text;
                }

                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.input-text;
                    placeholder-text: "Paste lyrics here…";
                    font-size: 14px;
                    init => {
                        self.focus();
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    PushButton {
                        text: "Load .txt / .lrc…";
                        clicked => {
                            root.load-file();
                        }
                    }

                    PushButton {
                        text: "Use lyrics shown in player";
                        enabled: root.use-shown-enabled;
                        clicked => {
                            root.use-shown();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    PushButton {
                        text: "Start syncing  →";
                        role: "primary";
                        clicked => {
                            root.start-syncing();
                        }
                    }
                }
            }

            // ---------- Page 1: syncing ----------
            if root.page == 1: VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                if !root.track-ok: Rectangle {
                    border-radius: 6px;
                    background: Theme.warn-bg;
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.warn-text;
                            color: Theme.warn-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    border-radius: 8px;
                    clip: true;
                    ScrollView {
                        content-y <=> root.list-scroll;
                        init => {
                            root.list-height = self.visible-height;
                        }
                        changed visible-height => {
                            root.list-height = self.visible-height;
                        }
                        VerticalLayout {
                            padding: 1px;
                            spacing: 2px;
                            alignment: start;
                            for row[i] in root.rows: Rectangle {
                                // Fixed heights, so Rust can work out where a row is.
                                height: row.sub != "" ? 62px : 42px;
                                border-radius: 4px;
                                background: row.selected ? Theme.sel : row-touch.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 9px;
                                    padding-bottom: 9px;
                                    spacing: 10px;
                                    Text {
                                        width: 14px;
                                        text: row.cursor ? "▶" : "";
                                        color: Theme.accent;
                                        font-size: 13px;
                                        vertical-alignment: top;
                                    }

                                    Text {
                                        width: 78px;
                                        text: row.time;
                                        font-family: "Consolas";
                                        font-size: 15px;
                                        color: row.time-look == 0 ? Theme.text-disabled : row.time-look == 2 ? Theme.error : Theme.time-ok;
                                        vertical-alignment: top;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        Text {
                                            height: 22px;
                                            text: row.main == "" ? "♪" : row.main;
                                            font-size: 16px;
                                            font-weight: row.look == 0 ? 700 : 400;
                                            color: row.look == 0 ? Theme.lyric-active : row.look == 1 ? Theme.faint2 : Theme.text-soft;
                                            overflow: elide;
                                        }

                                        if row.sub != "": Text {
                                            height: 18px;
                                            text: row.sub;
                                            font-size: 13px;
                                            color: Theme.lyric-inactive-sub;
                                            overflow: elide;
                                        }
                                    }
                                }

                                row-touch := TouchArea {
                                    clicked => {
                                        root.row-clicked(i);
                                    }
                                    double-clicked => {
                                        root.row-double-clicked(i);
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    PushButton {
                        text: "Restart";
                        enabled: root.track-ok;
                        clicked => {
                            root.restart();
                        }
                    }

                    PushButton {
                        text: "−5 s";
                        enabled: root.track-ok;
                        clicked => {
                            root.seek-relative(-5000);
                        }
                    }

                    PushButton {
                        width: 56px;
                        role: "iconButton";
                        icon: root.playing ? "pause" : "play";
                        clicked => {
                            root.toggle-play();
                        }
                    }

                    PushButton {
                        text: "+5 s";
                        enabled: root.track-ok;
                        clicked => {
                            root.seek-relative(5000);
                        }
                    }

                    Text {
                        text: root.time-text;
                        font-family: "Consolas";
                        font-size: 17px;
                        color: Theme.text-soft;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.progress-text;
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    PushButton {
                        text: "Stamp line   ⏎";
                        role: "primary";
                        enabled: root.track-ok;
                        clicked => {
                            root.stamp();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    PushButton {
                        text: "←  Edit text";
                        clicked => {
                            root.edit-text();
                        }
                    }

                    PushButton {
                        text: "Add ♪ break";
                        enabled: root.track-ok;
                        clicked => {
                            root.add-break();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    PushButton {
                        text: "Preview in player";
                        enabled: root.track-ok;
                        clicked => {
                            root.preview();
                        }
                    }

                    PushButton {
                        text: "Copy LRC";
                        clicked => {
                            root.copy-lrc();
                        }
                    }

                    PushButton {
                        text: "Embed in file";
                        tooltip: "Write the lyrics into the song itself, so they travel with it when you share it";
                        clicked => {
                            root.embed();
                        }
                    }

                    PushButton {
                        text: "Save .lrc";
                        role: "primary";
                        clicked => {
                            root.save();
                        }
                    }
                }

                Status {
                    text: root.status-text;
                }

                Help {
                    text: root.help-text;
                }
            }
        }
    }
}

// =======================================================================================
// Add translation
// =======================================================================================

export component TranslationDialog inherits Window {
    in property <string> window-title <=> root.title;
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 920px;
    preferred-height: 680px;
    min-width: 600px;
    min-height: 420px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";

    in property <int> page;
    in-out property <string> input-text;
    in property <string> intro-text;
    in property <string> hint-text;
    in property <string> counts-text;
    in property <bool> ai-ready;
    in property <string> ai-tip;
    in property <bool> busy;
    in property <string> busy-text;
    in property <bool> progress-known;
    in property <float> progress-value;
    in property <[TranslationRowData]> rows;
    in-out property <int> selected: -1;
    in-out property <int> editing: -1;
    in property <string> cover-text;
    in property <string> cover-tip;
    in property <string> status-text;
    in property <bool> status-error;
    in property <bool> raw-visible;

    callback text-edited(string);
    callback load-file();
    callback setup-ai();
    callback match-lines();
    callback align-ai();
    callback cancel-ai();
    callback shift-down();
    callback shift-up();
    callback clear-line();
    callback back-to-text();
    callback preview();
    callback embed();
    callback save();
    callback show-raw();
    callback replay(int);
    callback commit-edit(int, string);
    callback close-asked();

    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-keys() {
        keys.focus();
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.editing >= 0 {
                    root.editing = -1;
                    keys.focus();
                    return accept;
                }
                root.close-asked();
                return accept;
            }
            if event.modifiers.control && event.text.to-lowercase() == "s" {
                if root.page == 1 {
                    root.save();
                }
                return accept;
            }
            if root.page == 1 && root.editing < 0 {
                if event.text == Key.F2 && root.selected >= 0 {
                    root.editing = root.selected;
                    return accept;
                }
                if event.text == Key.UpArrow && root.selected > 0 {
                    root.selected -= 1;
                    return accept;
                }
                if event.text == Key.DownArrow && root.selected < root.rows.length - 1 {
                    root.selected += 1;
                    return accept;
                }
            }
            reject
        }

        VerticalLayout {
            padding: 18px;
            padding-bottom: 14px;
            spacing: 10px;

            // ---------- Page 0: paste the translation ----------
            if root.page == 0: VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                Muted {
                    text: root.intro-text;
                }

                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.input-text;
                    read-only: root.busy;
                    placeholder-text: "Paste the translation here…";
                    font-size: 14px;
                    edited(t) => {
                        root.text-edited(t);
                    }
                    init => {
                        self.focus();
                    }
                }

                Muted {
                    text: root.counts-text;
                }

                HorizontalLayout {
                    spacing: 6px;
                    PushButton {
                        text: "Load .txt / .lrc…";
                        enabled: !root.busy;
                        clicked => {
                            root.load-file();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if !root.ai-ready: PushButton {
                        text: "Set up AI…";
                        enabled: !root.busy;
                        clicked => {
                            root.setup-ai();
                        }
                    }

                    PushButton {
                        text: "Match line by line";
                        role: root.ai-ready ? "" : "primary";
                        enabled: !root.busy;
                        clicked => {
                            root.match-lines();
                        }
                    }

                    if root.ai-ready: PushButton {
                        text: "Align with AI";
                        role: "primary";
                        enabled: !root.busy;
                        tooltip: root.ai-tip;
                        clicked => {
                            root.align-ai();
                        }
                    }
                }

                if root.busy: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.busy-text;
                        color: Theme.status;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Progress {
                            known: root.progress-known;
                            value: root.progress-value;
                        }
                    }

                    PushButton {
                        text: "Cancel";
                        clicked => {
                            root.cancel-ai();
                        }
                    }
                }
            }

            // ---------- Page 1: review ----------
            if root.page == 1: VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    border-radius: 8px;
                    clip: true;
                    VerticalLayout {
                        // Header
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 16px;
                                Text {
                                    width: 62px;
                                    text: "Time";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: "Sung line";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: "Translation";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.surface-border;
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for row[i] in root.rows: Rectangle {
                                    property <bool> sel: i == root.selected;
                                    background: sel ? Theme.sel : row.empty ? Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.10) : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 16px;
                                        Rectangle {
                                            width: 62px;
                                            Text {
                                                width: 100%;
                                                text: row.time;
                                                color: sel ? Theme.sel-text : Theme.muted;
                                                font-size: 13px;
                                                vertical-alignment: top;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.selected = i;
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    root.replay(i);
                                                }
                                            }

                                            Tooltip {
                                                TipBox {
                                                    text: "Double-click to hear this line";
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            Text {
                                                width: 100%;
                                                text: row.sung;
                                                color: sel ? Theme.sel-text : Theme.text-soft;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                                vertical-alignment: top;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.selected = i;
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    root.replay(i);
                                                }
                                            }

                                            if row.sung-tip != "": Tooltip {
                                                TipBox {
                                                    text: row.sung-tip;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            min-height: root.editing == i ? 28px : 0px;
                                            if root.editing != i: Text {
                                                width: 100%;
                                                text: row.translation;
                                                color: sel ? Theme.sel-text : row.repeat ? Theme.faint : Theme.text-soft;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                                vertical-alignment: top;
                                            }
                                            if root.editing != i: TouchArea {
                                                clicked => {
                                                    root.selected = i;
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    root.selected = i;
                                                    root.editing = i;
                                                }
                                            }
                                            if root.editing != i && row.tip != "": Tooltip {
                                                TipBox {
                                                    text: row.tip;
                                                }
                                            }
                                            if root.editing == i: field := LineEdit {
                                                width: 100%;
                                                text: row.translation;
                                                font-size: 13px;
                                                init => {
                                                    self.focus();
                                                    self.select-all();
                                                }
                                                accepted(t) => {
                                                    root.editing = -1;
                                                    root.commit-edit(i, t);
                                                    keys.focus();
                                                }
                                                changed has-focus => {
                                                    if !self.has-focus && root.editing == i {
                                                        root.editing = -1;
                                                        root.commit-edit(i, self.text);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    PushButton {
                        text: "Shift down";
                        tooltip: "Push this translation and the ones after it one line down";
                        clicked => {
                            root.shift-down();
                        }
                    }

                    PushButton {
                        text: "Shift up";
                        tooltip: "Remove this line's translation and pull the ones after it up";
                        clicked => {
                            root.shift-up();
                        }
                    }

                    PushButton {
                        text: "Clear";
                        tooltip: "Remove this line's translation";
                        clicked => {
                            root.clear-line();
                        }
                    }

                    Rectangle {
                        width: 2px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.cover-text;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        if root.cover-tip != "": Tooltip {
                            TipBox {
                                text: root.cover-tip;
                            }
                        }
                    }

                    // Romaji arrives with M5; the button is there so the row looks the same.
                    PushButton {
                        width: 36px;
                        text: "あ";
                        role: "toggle";
                        enabled: false;
                        tooltip: "Show the sung lines as romaji";
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    PushButton {
                        text: "←  Edit translation";
                        clicked => {
                            root.back-to-text();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    PushButton {
                        text: "Preview in player";
                        clicked => {
                            root.preview();
                        }
                    }

                    PushButton {
                        text: "Embed in file";
                        tooltip: "Write the lyrics with the translation into the song itself";
                        clicked => {
                            root.embed();
                        }
                    }

                    PushButton {
                        text: "Save .lrc";
                        role: "primary";
                        clicked => {
                            root.save();
                        }
                    }
                }

                Help {
                    text: root.hint-text;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Status {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    error: root.status-error;
                }

                if root.raw-visible: PushButton {
                    text: "Show model's answer";
                    clicked => {
                        root.show-raw();
                    }
                }
            }
        }
    }
}

// =======================================================================================
// AI alignment settings
// =======================================================================================

component FieldLabel inherits Text {
    width: 100px;
    color: Theme.muted;
    font-size: 13px;
    vertical-alignment: center;
}

export component AiSettingsDialog inherits Window {
    title: "AI alignment";
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 600px;
    min-width: 600px;
    min-height: 470px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";

    in-out property <bool> ai-enabled;
    // "local" or "openrouter".
    in-out property <string> provider: "local";
    in-out property <string> url;
    in-out property <string> model;
    in-out property <string> key;
    in-out property <string> or-key;
    in-out property <string> or-model;
    in property <[string]> local-models;
    in property <[string]> suggestions;
    in property <string> cost-text;
    in property <bool> cost-error;
    in property <string> test-text;
    in property <bool> test-error;
    in property <bool> testing;
    in property <string> hint-text;
    in property <string> keys-url;
    in property <string> intro-text;
    property <int> highlighted: 0;
    property <bool> suggestions-dismissed: true;
    property <bool> show-suggestions: root.provider == "openrouter" && !root.suggestions-dismissed && root.suggestions.length > 0;

    callback provider-changed();
    callback get-key();
    callback or-model-edited(string);
    callback test();
    callback cancel();
    callback save();

    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-keys() {
        keys.focus();
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 20px;
            padding-bottom: 18px;
            spacing: 12px;
            alignment: start;

            Text {
                text: "AI alignment";
                font-size: 16px;
                font-weight: 600;
                color: Theme.title;
            }

            Muted {
                text: root.intro-text;
            }

            CheckBox {
                text: "Use AI to align translations";
                checked <=> root.ai-enabled;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                PushButton {
                    text: "On this computer";
                    role: "segment";
                    checked: root.provider == "local";
                    enabled: root.ai-enabled;
                    clicked => {
                        root.provider = "local";
                        root.provider-changed();
                    }
                }

                PushButton {
                    text: "OpenRouter (online)";
                    role: "segment";
                    checked: root.provider == "openrouter";
                    enabled: root.ai-enabled;
                    clicked => {
                        root.provider = "openrouter";
                        root.provider-changed();
                    }
                }
            }

            // ----- model on this computer
            if root.provider == "local": GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 8px;
                Row {
                    FieldLabel {
                        text: "Server address";
                    }

                    LineEdit {
                        colspan: 2;
                        text <=> root.url;
                        enabled: root.ai-enabled;
                        placeholder-text: "http://127.0.0.1:1234/v1";
                    }
                }

                Row {
                    FieldLabel {
                        text: "Model";
                    }

                    LineEdit {
                        text <=> root.model;
                        enabled: root.ai-enabled;
                        placeholder-text: "Filled in by Test connection";
                    }

                    pick-menu := ContextMenuArea {
                        Menu {
                            for m in root.local-models: MenuItem {
                                title: m;
                                activated => {
                                    root.model = m;
                                }
                            }
                        }

                        PushButton {
                            width: 100%;
                            height: 100%;
                            text: "Choose  ▾";
                            enabled: root.ai-enabled && root.local-models.length > 0;
                            tooltip: "Run Test connection to list the server's models";
                            clicked => {
                                pick-menu.show({ x: 0, y: self.height });
                            }
                        }
                    }
                }

                Row {
                    FieldLabel {
                        text: "API key";
                    }

                    LineEdit {
                        colspan: 2;
                        text <=> root.key;
                        enabled: root.ai-enabled;
                        input-type: password;
                        placeholder-text: "Usually not needed for local servers";
                    }
                }
            }

            // ----- OpenRouter
            if root.provider == "openrouter": GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 8px;
                Row {
                    FieldLabel {
                        text: "API key";
                    }

                    LineEdit {
                        text <=> root.or-key;
                        enabled: root.ai-enabled;
                        input-type: password;
                        placeholder-text: "sk-or-…";
                    }

                    PushButton {
                        text: "Get a key ↗";
                        role: "link";
                        enabled: root.ai-enabled;
                        tooltip: root.keys-url;
                        clicked => {
                            root.get-key();
                        }
                    }
                }

                Row {
                    FieldLabel {
                        text: "Model";
                    }

                    or-field := LineEdit {
                        colspan: 2;
                        text <=> root.or-model;
                        enabled: root.ai-enabled;
                        placeholder-text: "Run Test connection, then type to search (e.g. qwen)";
                        edited(t) => {
                            root.suggestions-dismissed = false;
                            root.highlighted = 0;
                            root.or-model-edited(t);
                        }
                        key-pressed(event) => {
                            if root.show-suggestions {
                                if event.text == Key.DownArrow {
                                    root.highlighted = min(root.highlighted + 1, root.suggestions.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow {
                                    root.highlighted = max(root.highlighted - 1, 0);
                                    return accept;
                                }
                                if event.text == Key.Return {
                                    root.or-model = root.suggestions[root.highlighted];
                                    root.suggestions-dismissed = true;
                                    root.or-model-edited(root.or-model);
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    root.suggestions-dismissed = true;
                                    return accept;
                                }
                            }
                            reject
                        }
                    }
                }

                if root.show-suggestions: Row {
                    Rectangle { }

                    // The QCompleter list under the field.
                    Rectangle {
                        colspan: 2;
                        height: min(root.suggestions.length, 6) * 28px + 10px;
                        background: Theme.menu;
                        border-width: 1px;
                        border-color: Theme.menu-border;
                        ScrollView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            VerticalLayout {
                                alignment: start;
                                for m[i] in root.suggestions: Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: i == root.highlighted || pick.has-hover ? Theme.sel : transparent;
                                    Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        text: m;
                                        color: i == root.highlighted || pick.has-hover ? Theme.sel-text : Theme.text-soft;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    pick := TouchArea {
                                        clicked => {
                                            root.or-model = m;
                                            root.suggestions-dismissed = true;
                                            root.or-model-edited(m);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Row {
                    Rectangle { }

                    Status {
                        colspan: 2;
                        text: root.cost-text;
                        error: root.cost-error;
                        color: root.cost-error ? Theme.error : Theme.muted;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                PushButton {
                    text: "Test connection";
                    enabled: root.ai-enabled && !root.testing;
                    clicked => {
                        root.test();
                    }
                }

                Status {
                    horizontal-stretch: 1;
                    text: root.test-text;
                    error: root.test-error;
                }
            }

            Help {
                text: root.hint-text;
                color: root.ai-enabled ? Theme.faint : Theme.text-disabled;
            }

            HorizontalLayout {
                spacing: 6px;
                padding-top: 4px;
                alignment: end;
                PushButton {
                    text: "Cancel";
                    clicked => {
                        root.cancel();
                    }
                }

                PushButton {
                    text: "Save";
                    role: "primary";
                    clicked => {
                        root.save();
                    }
                }
            }
        }
    }

}

// =======================================================================================
// A message with details (QMessageBox with setDetailedText)
// =======================================================================================

export component AnswerDialog inherits Window {
    in property <string> window-title <=> root.title;
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 480px;
    min-width: 380px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <string> message;
    in property <string> details;
    in-out property <bool> details-shown;
    callback dismiss();

    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.accent;
                    Text {
                        text: "i";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.message;
                    wrap: word-wrap;
                    font-size: 14px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }

            if root.details-shown: TextEdit {
                height: 240px;
                text: root.details;
                read-only: true;
                font-size: 12px;
            }

            HorizontalLayout {
                spacing: 8px;
                PushButton {
                    min-width: 120px;
                    text: root.details-shown ? "Hide Details…" : "Show Details…";
                    clicked => {
                        root.details-shown = !root.details-shown;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                PushButton {
                    min-width: 90px;
                    text: "OK";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}
