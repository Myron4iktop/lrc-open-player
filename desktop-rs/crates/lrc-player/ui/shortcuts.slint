// The F1 window (`show_shortcuts`): the keys in bold, what they do, and a note on drops.
// Rust fills the rows from `lrc_core::window::SHORTCUTS`.

import { Theme } from "theme.slint";
import { PushButton } from "widgets.slint";

export struct ShortcutRow {
    keys: string,
    action: string,
}

export component ShortcutsDialog inherits Window {
    title: "Keyboard shortcuts";
    icon: @image-url("../../../../desktop/favicon.ico");
    background: Theme.bg;
    default-font-family: "Segoe UI";
    in property <[ShortcutRow]> rows;
    in property <string> footer;
    callback dismiss();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return || event.text == " " {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            VerticalLayout {
                spacing: 6px;
                for row in root.rows: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        width: 150px;
                        text: row.keys;
                        font-weight: 700;
                        font-size: 12px;
                        color: Theme.text;
                    }

                    Text {
                        text: row.action;
                        font-size: 12px;
                        color: Theme.text;
                    }
                }
            }

            Text {
                text: root.footer;
                wrap: word-wrap;
                font-size: 12px;
                color: Theme.text;
            }

            HorizontalLayout {
                alignment: end;
                PushButton {
                    width: 80px;
                    text: "OK";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}
