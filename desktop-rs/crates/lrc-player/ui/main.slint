// The main window: `_init_ui` and friends in lrcplayer.py.
//
// Left: the Open, Lyrics, View and Tracklist buttons, the cover, title and artist, the
// seek bar, the audio badge, the transport controls and the lyrics offset. Middle: the
// tracklist drawer. Right: the lyrics. Rust (src/app.rs) owns the state and the rules;
// this file only lays them out.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MediaIcon } from "icons.slint";
import { PushButton, HSlider, TipBox } from "widgets.slint";
import { LyricCard, LyricLineData } from "lyrics.slint";
import { DropMenu } from "menu.slint";
export { ShortcutsDialog, ShortcutRow } from "shortcuts.slint";
export { DetailsDialog, DetailRow, QuestionDialog, ErrorDialog, LyricsChoicesDialog, ChoiceRowData } from "dialogs.slint";
export { SyncDialog, SyncRowData, TranslationDialog, TranslationRowData, AiSettingsDialog, AnswerDialog, PublishDialog } from "editors.slint";
export { Theme, LyricLineData }

export component MainWindow inherits Window {
    title: "LRC Open Player";
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 1150px;
    preferred-height: 780px;
    min-width: 760px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    full-screen <=> root.fullscreen;

    // --- Track ---
    in property <bool> has-track;
    in property <string> track-title: "No track loaded";
    in property <string> track-artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> specs-text;
    // --- Playback ---
    in property <bool> playing;
    in property <bool> muted;
    in-out property <float> seek-value;
    in property <float> seek-max;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> volume: 80;
    in property <bool> shuffle;
    in property <string> repeat: "off";
    in property <string> repeat-tip: "Repeat: off   ( L )";
    in property <string> offset-text: "+0.0 s";
    // This song has an offset of its own, on top of the default for all songs.
    in property <bool> song-offset;
    // --- Tracklist ---
    in property <string> queue-title: "Album Tracklist";
    in property <[string]> queue-rows;
    in-out property <int> queue-current: -1;
    in-out property <bool> queue-visible;
    // A row to bring into view in the tracklist (songs were just added, or another song
    // plays), or -1. Rust sets the row and bumps the count; the list scrolls and sets the
    // row back to -1.
    in-out property <int> queue-reveal: -1;
    in property <int> queue-reveal-count;
    // --- Lyrics ---
    in property <[LyricLineData]> lines;
    in property <bool> synced;
    in property <string> lyrics-message;
    // "status" (lyricsStatus) or "empty" (lyricsEmpty), the two looks of a note.
    in property <string> lyrics-message-kind: "status";
    // Lyrics ▾ → Let me choose the version: a search lists every version LRCLIB has.
    in property <bool> choose-lyrics;
    in-out property <length> lyrics-scroll;
    in property <int> rescale-count;
    // --- Window ---
    in-out property <bool> fullscreen;
    // The あ button (`btn_romaji`) is on.
    in property <bool> romaji-on;
    in property <bool> drop-visible;
    in property <string> drop-headline;
    in property <string> drop-detail;
    // A third, fainter line: how to add to the tracklist instead of replacing it.
    in property <string> drop-hint;
    in property <string> theme-key: "dark";
    // View → Smooth animation: GPU drawing, from the next start.
    in property <bool> smooth-animation;
    in property <string> accent-key: "coral";
    in property <[image]> accent-icons;
    // --- Visualizer and tray ---
    in property <string> visualizer-mode: "off";
    // The spectrum, drawn by Rust into the bottom of the lyrics area.
    in property <image> viz-frame;
    in property <color> viz-accent;
    in property <float> viz-alpha;
    out property <length> lyrics-width: lyrics-area.width;
    out property <length> lyrics-height: lyrics-area.height;
    in property <bool> close-to-tray;
    in property <bool> tray-available;

    callback open-file();
    callback open-album();
    callback add-songs();
    callback open-playlist();
    callback save-playlist();
    callback load-lrc();
    callback search-online();
    callback set-choose-lyrics(bool);
    callback embed-lyrics();
    callback show-details();
    callback show-shortcuts();
    callback set-theme(string);
    callback set-smooth-animation(bool);
    callback set-accent(string);
    callback toggle-play();
    callback previous();
    callback next();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-mute();
    callback volume-changed(float);
    callback seek-pressed();
    callback seek-released(float);
    callback offset-step(int);
    callback offset-reset();
    callback offset-for-all();
    callback queue-play(int);
    // The ✕ of a tracklist row, and a row dragged from one place to another.
    callback queue-remove(int);
    callback queue-move(int, int);
    callback line-clicked(int);
    callback toggle-fullscreen();
    callback set-visualizer(string);
    callback cycle-visualizer();
    callback set-close-to-tray(bool);
    callback open-sync();
    callback open-translation();
    callback open-ai-settings();
    callback toggle-romaji();

    // Menus follow the theme too (they are drawn by Slint's own style).
    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-window() {
        keys.focus();
    }

    // --- Smooth scroll of the lyrics: 360 ms, out-cubic (`_smooth_scroll_to_card`) ---
    property <length> scroll-from;
    property <length> scroll-to;
    property <duration> scroll-start;

    public function scroll-lyrics-to(target: length) {
        root.scroll-from = -root.lyrics-scroll;
        root.scroll-to = target;
        root.scroll-start = animation-tick();
        scroll-anim.running = true;
    }

    public function stop-lyrics-scroll() {
        scroll-anim.running = false;
    }

    // Steps finer than one frame even at 240 Hz, so every frame shows a new position
    // (a 10 ms step left some 120 Hz frames repeating the last one, and Windows timers
    // rounded it to 15.6 ms). The position comes from the frame clock, not the step count.
    scroll-anim := Timer {
        interval: 2ms;
        running: false;
        triggered => {
            let t = min(1, (animation-tick() - root.scroll-start) / 360ms);
            let eased = 1 - pow(1 - t, 3);
            root.lyrics-scroll = -(root.scroll-from + (root.scroll-to - root.scroll-from) * eased);
            if t >= 1 {
                self.running = false;
            }
        }
    }

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            // A held key acts once (Qt shortcuts without auto-repeat), so holding Space
            // doesn't toggle over and over. Only the offset keys repeat.
            if event.repeat && event.text != "[" && event.text != "]" {
                return accept;
            }
            // Menu shortcuts first, as Qt's QActions take them before keyPressEvent.
            if event.modifiers.control && !event.modifiers.alt {
                let k = event.text.to-lowercase();
                if k == "o" && event.modifiers.shift {
                    root.open-album();
                    return accept;
                }
                if k == "o" {
                    root.open-file();
                    return accept;
                }
                if k == "a" && event.modifiers.shift {
                    root.add-songs();
                    return accept;
                }
                if k == "l" && !event.modifiers.shift {
                    root.load-lrc();
                    return accept;
                }
                if k == "i" && !event.modifiers.shift && root.has-track {
                    root.show-details();
                    return accept;
                }
                if k == "t" && event.modifiers.shift && root.has-track {
                    root.open-translation();
                    return accept;
                }
                if k == "t" && root.has-track {
                    root.open-sync();
                    return accept;
                }
            }
            if event.text == Key.F1 {
                root.show-shortcuts();
                return accept;
            }
            // keyPressEvent
            if event.text == Key.F11 {
                root.toggle-fullscreen();
                return accept;
            }
            if event.text == Key.Escape && root.fullscreen {
                root.toggle-fullscreen();
                return accept;
            }
            if event.text == " " {
                root.toggle-play();
                return accept;
            }
            if event.modifiers.control && event.text == Key.RightArrow {
                root.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                root.previous();
                return accept;
            }
            if event.text == "[" {
                root.offset-step(-100);
                return accept;
            }
            if event.text == "]" {
                root.offset-step(100);
                return accept;
            }
            if event.text == "\\" {
                root.offset-reset();
                return accept;
            }
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                let k = event.text.to-lowercase();
                if k == "r" {
                    root.toggle-romaji();
                    return accept;
                }
                if k == "s" {
                    root.toggle-shuffle();
                    return accept;
                }
                if k == "l" {
                    root.cycle-repeat();
                    return accept;
                }
                if k == "m" {
                    root.toggle-mute();
                    return accept;
                }
                if k == "v" {
                    root.cycle-visualizer();
                    return accept;
                }
            }
            reject
        }

        // Double-click anywhere that isn't a control: fullscreen (`mouseDoubleClickEvent`).
        TouchArea {
            double-clicked => {
                root.toggle-fullscreen();
            }
        }

        HorizontalLayout {
            padding: 25px;
            spacing: 25px;

            // ------------------------------------------------------------------
            // Left panel
            // ------------------------------------------------------------------
            left := VerticalLayout {
                width: root.fullscreen ? 420px : 330px;
                spacing: 10px;
                alignment: start;

                GridLayout {
                    spacing: 6px;
                    Row {
                        PushButton {
                            text: "Open";
                            glyph: "menu";
                            clicked => {
                                open-menu.open(0, self.height + 2px);
                            }

                            open-menu := DropMenu {
                                x: 0;
                                y: 0;
                                widest-shortcut: "Ctrl+Shift+O";
                                entries: [
                                    { id: "file", title: "Audio files…", shortcut: "Ctrl+O" },
                                    { id: "album", title: "Album folder…", shortcut: "Ctrl+Shift+O" },
                                    { id: "playlist", title: "Playlist…" },
                                    { id: "-" },
                                    { id: "add", title: "Add songs to tracklist…", shortcut: "Ctrl+Shift+A" },
                                    { id: "save-playlist", title: "Save tracklist as playlist…", disabled: root.queue-rows.length == 0 },
                                ];
                                activated(id) => {
                                    if id == "file" {
                                        root.open-file();
                                    } else if id == "add" {
                                        root.add-songs();
                                    } else if id == "playlist" {
                                        root.open-playlist();
                                    } else if id == "save-playlist" {
                                        root.save-playlist();
                                    } else {
                                        root.open-album();
                                    }
                                }
                            }
                        }

                        PushButton {
                            text: "Lyrics";
                            glyph: "menu";
                            clicked => {
                                lyrics-menu.open(0, self.height + 2px);
                            }

                            lyrics-menu := DropMenu {
                                x: 0;
                                y: 0;
                                widest-shortcut: "Ctrl+Shift+T";
                                check-col: true;
                                entries: [
                                    { id: "lrc", title: "Load LRC file…", shortcut: "Ctrl+L" },
                                    { id: "search", title: root.choose-lyrics ? "Search online (LRCLIB)…" : "Search online (LRCLIB)", disabled: !root.has-track },
                                    { id: "choose", title: "Let me choose the version", checkable: true, checked: root.choose-lyrics },
                                    { id: "-" },
                                    { id: "sync", title: "Sync lyrics…", shortcut: "Ctrl+T", disabled: !root.has-track },
                                    { id: "translate", title: "Add translation…", shortcut: "Ctrl+Shift+T", disabled: !root.has-track },
                                    { id: "embed", title: "Embed lyrics in file…", disabled: !root.has-track },
                                    { id: "-" },
                                    { id: "offset-all", title: "Use this offset for all songs", disabled: !root.song-offset },
                                ];
                                activated(id) => {
                                    if id == "lrc" {
                                        root.load-lrc();
                                    } else if id == "search" {
                                        root.search-online();
                                    } else if id == "choose" {
                                        root.set-choose-lyrics(!root.choose-lyrics);
                                    } else if id == "sync" {
                                        root.open-sync();
                                    } else if id == "translate" {
                                        root.open-translation();
                                    } else if id == "embed" {
                                        root.embed-lyrics();
                                    } else if id == "offset-all" {
                                        root.offset-for-all();
                                    }
                                }
                            }
                        }
                    }

                    Row {
                        PushButton {
                            text: "View";
                            glyph: "menu";
                            clicked => {
                                view-menu.open(0, self.height + 2px);
                            }

                            view-menu := DropMenu {
                                x: 0;
                                y: 0;
                                widest-shortcut: "Ctrl+I";
                                check-col: true;
                                entries: [
                                    { id: "details", title: "Track details…", shortcut: "Ctrl+I", disabled: !root.has-track },
                                    { id: "-" },
                                    { id: "theme", title: "Theme", sub: 1 },
                                    { id: "accent", title: "Accent color", sub: 2 },
                                    { id: "viz", title: "Visualizer", sub: 3 },
                                    { id: "smooth", title: "Smooth animation (GPU)", checkable: true, checked: root.smooth-animation },
                                    { id: "-" },
                                    { id: "tray", title: "Keep playing in tray when closed", checkable: true, checked: root.close-to-tray, disabled: !root.tray-available },
                                    { id: "ai", title: "AI alignment…" },
                                    { id: "shortcuts", title: "Keyboard shortcuts", shortcut: "F1" },
                                ];
                                sub-check-col: [true, true, true];
                                subs: [
                                    [
                                        { id: "theme:dark", title: "Dark", checkable: true, checked: root.theme-key == "dark" },
                                        { id: "theme:light", title: "Light", checkable: true, checked: root.theme-key == "light" },
                                    ],
                                    [
                                        { id: "accent:coral", title: "Coral", checkable: true, icon: root.accent-icons[0] },
                                        { id: "accent:rose", title: "Rose", checkable: true, icon: root.accent-icons[1] },
                                        { id: "accent:amber", title: "Amber", checkable: true, icon: root.accent-icons[2] },
                                        { id: "accent:jade", title: "Jade", checkable: true, icon: root.accent-icons[3] },
                                        { id: "accent:aqua", title: "Aqua", checkable: true, icon: root.accent-icons[4] },
                                        { id: "accent:azure", title: "Azure", checkable: true, icon: root.accent-icons[5] },
                                        { id: "accent:violet", title: "Violet", checkable: true, icon: root.accent-icons[6] },
                                    ],
                                    [
                                        { id: "viz:off", title: "Off", checkable: true, checked: root.visualizer-mode == "off" },
                                        { id: "viz:bars", title: "Spectrum bars", checkable: true, checked: root.visualizer-mode == "bars" },
                                        { id: "viz:wave", title: "Soft wave", checkable: true, checked: root.visualizer-mode == "wave" },
                                    ],
                                ];
                                activated(id) => {
                                    if id == "shortcuts" {
                                        root.show-shortcuts();
                                    } else if id == "ai" {
                                        root.open-ai-settings();
                                    } else if id == "details" {
                                        root.show-details();
                                    } else if id == "smooth" {
                                        root.set-smooth-animation(!root.smooth-animation);
                                    } else if id == "theme:dark" || id == "theme:light" {
                                        root.set-theme(id == "theme:dark" ? "dark" : "light");
                                    } else if id == "accent:coral" {
                                        root.set-accent("coral");
                                    } else if id == "accent:rose" {
                                        root.set-accent("rose");
                                    } else if id == "accent:amber" {
                                        root.set-accent("amber");
                                    } else if id == "accent:jade" {
                                        root.set-accent("jade");
                                    } else if id == "accent:aqua" {
                                        root.set-accent("aqua");
                                    } else if id == "accent:azure" {
                                        root.set-accent("azure");
                                    } else if id == "accent:violet" {
                                        root.set-accent("violet");
                                    } else if id == "viz:off" || id == "viz:bars" || id == "viz:wave" {
                                        root.set-visualizer(id == "viz:off" ? "off" : id == "viz:bars" ? "bars" : "wave");
                                    } else if id == "tray" {
                                        root.set-close-to-tray(!root.close-to-tray);
                                    }
                                }
                            }
                        }

                        PushButton {
                            text: "Tracklist";
                            glyph: "list";
                            enabled: root.queue-rows.length > 0;
                            clicked => {
                                root.queue-visible = !root.queue-visible;
                            }
                        }
                    }
                }

                // Cover art
                Rectangle {
                    width: left.width;
                    height: left.width;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    background: Theme.surface2;
                    clip: true;

                    if !root.has-cover: Text {
                        text: "No Album Art";
                        color: Theme.muted;
                        font-size: 12px;
                    }

                    if root.has-cover: Image {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                        image-fit: ImageFit.cover;
                    }

                    Tooltip {
                        TipBox {
                            text: "Double-click anywhere or press F11 for fullscreen\nF1 shows all keyboard shortcuts";
                        }
                    }
                }

                Text {
                    text: root.track-title;
                    wrap: word-wrap;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.title;
                }

                Text {
                    text: root.track-artist;
                    wrap: word-wrap;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.artist;
                }

                // Seek bar
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.position-text;
                        font-size: 12px;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }

                    HSlider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: max(root.seek-max, 1);
                        value <=> root.seek-value;
                        pressed => {
                            root.seek-pressed();
                        }
                        released(v) => {
                            root.seek-released(v);
                        }
                    }

                    Text {
                        text: root.duration-text;
                        font-size: 12px;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                }

                // Audio badge
                if root.specs-text != "": Rectangle {
                    border-radius: 4px;
                    background: Theme.badge-bg;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        Text {
                            text: root.specs-text;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.badge-text;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Shuffle, previous, play, next, repeat, mute and volume
                HorizontalLayout {
                    spacing: 5px;
                    PushButton {
                        width: 32px;
                        role: "iconToggle";
                        checked: root.shuffle;
                        icon: "shuffle";
                        icon-color: root.shuffle ? Theme.accent : Theme.icon-muted;
                        tooltip: root.shuffle ? "Shuffle: on   ( S )" : "Shuffle: off   ( S )";
                        clicked => {
                            root.toggle-shuffle();
                        }
                    }

                    PushButton {
                        width: 40px;
                        role: "iconButton";
                        icon: "prev";
                        tooltip: "Previous track   ( Ctrl+← )";
                        clicked => {
                            root.previous();
                        }
                    }

                    PushButton {
                        width: 52px;
                        role: "iconButton";
                        icon: root.playing ? "pause" : "play";
                        tooltip: "Play / pause   ( Space )";
                        clicked => {
                            root.toggle-play();
                        }
                    }

                    PushButton {
                        width: 40px;
                        role: "iconButton";
                        icon: "next";
                        tooltip: "Next track   ( Ctrl+→ )";
                        clicked => {
                            root.next();
                        }
                    }

                    PushButton {
                        width: 32px;
                        role: "iconToggle";
                        checked: root.repeat != "off";
                        icon: root.repeat == "track" ? "repeat_one" : "repeat";
                        icon-color: root.repeat != "off" ? Theme.accent : Theme.icon-muted;
                        tooltip: root.repeat-tip;
                        clicked => {
                            root.cycle-repeat();
                        }
                    }

                    Rectangle {
                        width: 4px;
                    }

                    PushButton {
                        width: 28px;
                        role: "iconFlat";
                        icon: root.muted ? "mute" : "volume";
                        icon-color: root.muted ? Theme.accent : Theme.icon-muted;
                        tooltip: root.muted ? "Unmute   ( M )" : "Mute   ( M )";
                        clicked => {
                            root.toggle-mute();
                        }
                    }

                    HSlider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 100;
                        value <=> root.volume;
                        tooltip: "Volume";
                        moved(v) => {
                            root.volume-changed(round(v));
                        }
                    }
                }

                // Lyrics sync:  [ − ]  +0.0 s  [ + ]  [Reset]            [あ]
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Lyrics sync:";
                        font-size: 12px;
                        color: Theme.dim;
                        vertical-alignment: center;
                    }

                    PushButton {
                        width: 32px;
                        text: "−";
                        tooltip: "Show this song's lyrics earlier by 0.1 s   ( [ )";
                        clicked => {
                            root.offset-step(-100);
                        }
                    }

                    Text {
                        min-width: 52px;
                        text: root.offset-text;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    PushButton {
                        width: 32px;
                        text: "+";
                        tooltip: "Show this song's lyrics later by 0.1 s   ( ] )";
                        clicked => {
                            root.offset-step(100);
                        }
                    }

                    PushButton {
                        width: 56px;
                        text: "Reset";
                        tooltip: "Back to the default offset for all songs   ( \\ )";
                        clicked => {
                            root.offset-reset();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    PushButton {
                        width: 36px;
                        text: "あ";
                        role: "toggle";
                        checked: root.romaji-on;
                        tooltip: "Show Japanese lyrics as romaji   ( R )";
                        clicked => {
                            root.toggle-romaji();
                        }
                    }
                }
            }

            // ------------------------------------------------------------------
            // Tracklist drawer
            // ------------------------------------------------------------------
            if root.queue-visible: VerticalLayout {
                width: 280px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: root.queue-title;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.title;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    PushButton {
                        width: 26px;
                        height: 26px;
                        min-h: 26px;
                        text: "+";
                        font-size: 15px;
                        tooltip: "Add songs to the tracklist   ( Ctrl+Shift+A )";
                        clicked => {
                            root.add-songs();
                        }
                    }

                    Rectangle {
                        width: 6px;
                    }

                    PushButton {
                        width: 26px;
                        height: 26px;
                        min-h: 26px;
                        glyph: "close";
                        clicked => {
                            root.queue-visible = false;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    border-radius: 8px;
                    clip: true;

                    queue-list := Flickable {
                        x: 5px;
                        y: 5px;
                        width: parent.width - 10px;
                        height: parent.height - 10px;
                        // The rows' height, from their number (44 px each, 2 px apart)
                        // and not from `rows.preferred-height`: rows just added aren't
                        // laid out yet, and the list couldn't scroll down to them.
                        content-height: max(0px, root.queue-rows.length * 46px - 2px);
                        // The wheel scrolls the list; dragging moves a row instead.
                        interactive: false;

                        // --- Dragging a row to another place ---
                        // The row being dragged, or -1.
                        property <int> drag-from: -1;
                        // Where the pointer is, down from the top of the visible list.
                        property <length> drag-view-y;
                        // The gap the row would be dropped into: 0 is above the first row.
                        property <int> drag-slot: clamp(round((self.drag-view-y - self.content-y) / 46px), 0, root.queue-rows.length);
                        // The place the row would end up at.
                        property <int> drag-to: self.drag-slot > self.drag-from ? self.drag-slot - 1 : self.drag-slot;
                        // The press that just ended was a drag, so it isn't also a click.
                        property <bool> was-drag;

                        // Scrolls a row to the middle if it isn't in view: one Rust asked
                        // for (songs were added, another song plays), or the playing
                        // song when the drawer opens.
                        property <int> reveal-count: root.queue-reveal-count;
                        function reveal(row: int) {
                            if row >= 0 && self.height > 0 {
                                let top = row * 46px;
                                if top < -self.content-y || top + 44px > self.height - self.content-y {
                                    let most = max(0px, self.content-height - self.height);
                                    self.content-y = -clamp(top - (self.height - 44px) / 2, 0px, most);
                                }
                            }
                        }
                        changed reveal-count => {
                            self.reveal(root.queue-reveal);
                            root.queue-reveal = -1;
                        }
                        init => {
                            self.reveal(root.queue-reveal >= 0 ? root.queue-reveal : root.queue-current);
                            root.queue-reveal = -1;
                        }

                        rows := VerticalLayout {
                            width: queue-list.width;
                            spacing: 2px;
                            alignment: start;
                            for row[i] in root.queue-rows: Rectangle {
                                height: 44px;
                                border-radius: 6px;
                                background: i == root.queue-current ? Theme.sel : row-touch.has-hover || remove-touch.has-hover ? Theme.hover : transparent;
                                opacity: queue-list.drag-from == i ? 0.45 : 1;

                                Text {
                                    x: 10px;
                                    width: parent.width - 46px;
                                    height: 100%;
                                    text: row;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    font-weight: i == root.queue-current ? 700 : 400;
                                    color: i == root.queue-current ? Theme.sel-text : Theme.list-text;
                                }

                                row-touch := TouchArea {
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                            queue-list.was-drag = false;
                                        }
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && queue-list.drag-from == i {
                                            queue-list.was-drag = true;
                                            queue-list.drag-from = -1;
                                            if queue-list.drag-to != i {
                                                root.queue-move(i, queue-list.drag-to);
                                            }
                                        }
                                        if event.kind == PointerEventKind.cancel {
                                            queue-list.drag-from = -1;
                                        }
                                    }
                                    moved => {
                                        // A drag starts once the pointer has gone 8 px up or down.
                                        if self.pressed && root.queue-rows.length > 1 && (queue-list.drag-from == i || abs((self.mouse-y - self.pressed-y) / 1px) > 8) {
                                            queue-list.drag-view-y = parent.y + self.mouse-y + queue-list.content-y;
                                            queue-list.drag-from = i;
                                        }
                                    }
                                    clicked => {
                                        if !queue-list.was-drag {
                                            root.queue-current = i;
                                        }
                                    }
                                    double-clicked => {
                                        root.queue-play(i);
                                    }
                                }

                                // ✕ at the end of the row under the pointer: takes the
                                // song out of the tracklist. The last song stays.
                                remove-touch := TouchArea {
                                    x: parent.width - 30px;
                                    y: (parent.height - 24px) / 2;
                                    width: 24px;
                                    height: 24px;
                                    enabled: root.queue-rows.length > 1 && queue-list.drag-from < 0;
                                    clicked => {
                                        root.queue-remove(i);
                                    }

                                    // Only the ✕ comes and goes with the pointer: the
                                    // area itself is always there to be clicked.
                                    Rectangle {
                                        visible: remove-touch.enabled && (row-touch.has-hover || remove-touch.has-hover);
                                        border-radius: 5px;
                                        background: remove-touch.has-hover ? Theme.btn-hover : transparent;
                                        Path {
                                            width: 8px;
                                            height: 8px;
                                            viewbox-width: 10;
                                            viewbox-height: 10;
                                            stroke: i == root.queue-current ? Theme.sel-text : Theme.muted;
                                            stroke-width: 1.3px;
                                            commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                                        }
                                    }
                                }
                            }
                        }

                        // Where the dragged row would go.
                        if queue-list.drag-from >= 0 && queue-list.drag-to != queue-list.drag-from: Rectangle {
                            x: 4px;
                            y: clamp(queue-list.drag-slot * 46px - 2px, 0px, max(0px, queue-list.content-height - 2px));
                            width: queue-list.width - 8px;
                            height: 2px;
                            border-radius: 1px;
                            background: Theme.accent;
                        }
                    }

                    // While a row is dragged near the top or bottom edge, the list scrolls.
                    Timer {
                        interval: 16ms;
                        running: queue-list.drag-from >= 0;
                        triggered => {
                            if queue-list.drag-view-y < 26px {
                                queue-list.content-y = min(0px, queue-list.content-y + 9px);
                            } else if queue-list.drag-view-y > queue-list.height - 26px {
                                queue-list.content-y = max(-max(0px, queue-list.content-height - queue-list.height), queue-list.content-y - 9px);
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------------------------
            // Lyrics
            // ------------------------------------------------------------------
            lyrics-area := Rectangle {
                horizontal-stretch: 1;

                // `VisualizerBackdrop`: behind the lyrics, at the bottom.
                if root.visualizer-mode != "off": Image {
                    x: 0;
                    width: parent.width;
                    height: self.source.height * 1phx;
                    y: parent.height - self.height;
                    source: root.viz-frame;
                    image-fit: fill;
                }

                if root.lyrics-message != "": VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 100px;
                    alignment: start;
                    Text {
                        text: root.lyrics-message;
                        wrap: word-wrap;
                        font-size: 16px;
                        font-weight: root.lyrics-message-kind == "status" ? 500 : 400;
                        color: root.lyrics-message-kind == "status" ? Theme.artist : Theme.faint;
                    }
                }

                lyrics-flick := Flickable {
                    content-y <=> root.lyrics-scroll;
                    content-height: max(self.height, cards.preferred-height);

                    TouchArea {
                        double-clicked => {
                            root.toggle-fullscreen();
                        }
                    }

                    cards := VerticalLayout {
                        width: lyrics-flick.width;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 100px;
                        padding-bottom: 160px;
                        spacing: 10px;
                        alignment: start;

                        for line[i] in root.lines: LyricCard {
                            main: line.main;
                            sub: line.sub;
                            active: line.active;
                            synced: root.synced;
                            fullscreen: root.fullscreen;
                            rescale-count: root.rescale-count;
                            clicked => {
                                root.line-clicked(i);
                            }
                            double-clicked => {
                                root.toggle-fullscreen();
                            }
                            scroll-request(y, h) => {
                                let most = max(0px, lyrics-flick.content-height - lyrics-flick.height);
                                root.scroll-lyrics-to(clamp(y - (lyrics-flick.height - h) / 2, 0px, most));
                            }
                        }
                    }
                }
            }
        }

        // Shown while files are dragged over the window (`_show_drop_overlay`).
        if root.drop-visible: Rectangle {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            background: Theme.overlay;
            border-width: 2px;
            border-color: Theme.accent;
            border-radius: 18px;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: root.drop-headline;
                    font-size: 22px;
                    font-weight: 600;
                    color: Theme.title;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.drop-detail;
                    font-size: 13px;
                    font-weight: 400;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }

                if root.drop-hint != "": Text {
                    text: root.drop-hint;
                    font-size: 12px;
                    font-weight: 400;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Rust bumps this when the window comes back from the taskbar. Changing the color of
    // this invisible full-window layer makes the renderer repaint every pixel, instead of
    // only the parts it thinks changed, which left parts of the window unpainted on Windows.
    in property <int> repaint-count;
    Rectangle {
        background: Math.mod(root.repaint-count, 2) == 0 ? transparent : #00000001;
    }
}
