// Small windows of the lyrics flow:
//
// - `DetailsDialog`: Ctrl+I, the Track Details window (`MetadataDialog`).
// - `QuestionDialog`: the offer to save lyrics found online (`_offer_to_save_online_lyrics`),
//   which needs its own button texts and a default button that a system message box
//   can't give.
// - `ErrorDialog`: an unexpected error (`install_error_handler`), with its details
//   behind "Show Details…" as in a QMessageBox.
// - `LyricsChoicesDialog`: every version of a song's lyrics LRCLIB has, to pick one from
//   (Lyrics ▾ → Let me choose the version). Not in the Python app.

import { ScrollView, TextEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PushButton } from "widgets.slint";

export struct DetailRow {
    label: string,
    value: string,
}

export component DetailsDialog inherits Window {
    title: "Track Details";
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 500px;
    preferred-height: 680px;
    min-width: 360px;
    min-height: 360px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <image> cover;
    in property <bool> has-cover;
    in property <[DetailRow]> rows;
    callback dismiss();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "Track Details";
                font-size: 18px;
                font-weight: 700;
                color: Theme.title;
            }

            if root.has-cover: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 140px;
                    height: 140px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                        image-fit: ImageFit.cover;
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    for row in root.rows: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            width: 110px;
                            text: row.label;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.dim;
                            vertical-alignment: top;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: row.value;
                            font-size: 13px;
                            color: Theme.text-soft;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                PushButton {
                    width: 90px;
                    text: "Close";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}

export component QuestionDialog inherits Window {
    in property <string> window-title <=> root.title;
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 460px;
    min-width: 360px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <string> question;
    in property <string> notes;
    in property <string> yes-text: "Yes";
    in property <string> no-text: "No";
    // Which button Enter presses: the safe one when something would be replaced.
    in property <bool> default-no;
    callback answered(bool);

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.answered(false);
                return accept;
            }
            if event.text == Key.Return {
                root.answered(!root.default-no);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 14px;
                // The question mark of QMessageBox.Icon.Question.
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.accent;
                    Text {
                        text: "?";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.question;
                        wrap: word-wrap;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    if root.notes != "": Text {
                        text: root.notes;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.text-soft;
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PushButton {
                    min-width: 90px;
                    text: root.yes-text;
                    clicked => {
                        root.answered(true);
                    }
                }

                PushButton {
                    min-width: 90px;
                    text: root.no-text;
                    clicked => {
                        root.answered(false);
                    }
                }
            }
        }
    }
}

export component ErrorDialog inherits Window {
    title: "LRC Open Player";
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 480px;
    min-width: 380px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <string> summary;
    in property <string> details;
    in-out property <bool> details-shown;
    callback dismiss();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 14px;
                // The exclamation mark of QMessageBox.Icon.Warning.
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.warn-bg;
                    border-width: 1px;
                    border-color: Theme.warn-text;
                    Text {
                        text: "!";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.warn-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    Text {
                        text: "Something went wrong, but the player is still running.";
                        wrap: word-wrap;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    if root.summary != "": Text {
                        text: root.summary;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.text-soft;
                    }
                }
            }

            if root.details-shown: TextEdit {
                height: 200px;
                text: root.details;
                read-only: true;
                wrap: no-wrap;
                font-size: 12px;
            }

            HorizontalLayout {
                spacing: 8px;
                PushButton {
                    min-width: 120px;
                    text: root.details-shown ? "Hide Details…" : "Show Details…";
                    clicked => {
                        root.details-shown = !root.details-shown;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                PushButton {
                    min-width: 90px;
                    text: "OK";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}

// One version in `LyricsChoicesDialog`: `lrc_core::window::ChoiceRow`.
export struct ChoiceRowData {
    title: string,
    detail: string,
    // "Synced" or "Plain text".
    kind: string,
    synced: bool,
}

// The versions of a song's lyrics found on LRCLIB. Picking a row shows that version in
// the player at once (`picked`), so it can be checked against the song as it plays;
// "Use these lyrics" keeps the picked one and Cancel puts the old lyrics back.
export component LyricsChoicesDialog inherits Window {
    in property <string> window-title <=> root.title;
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 580px;
    preferred-height: 540px;
    min-width: 420px;
    min-height: 320px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <string> heading;
    in property <string> hint;
    in property <[ChoiceRowData]> rows;
    // The row whose lyrics are in the player.
    in-out property <int> current;
    callback picked(int);
    callback accepted();
    callback dismiss();

    // The list's scroll bar follows the theme (it is drawn by Slint's own style).
    public function sync-color-scheme() {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <length> row-height: 54px;
    property <length> row-gap: 2px;

    function pick(row: int) {
        if row < 0 || row >= root.rows.length || row == root.current {
            return;
        }
        root.current = row;
        // Keep the picked row in view when the arrow keys move past the edge.
        let top = row * (root.row-height + root.row-gap);
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + root.row-height > -list.content-y + list.visible-height {
            list.content-y = -(top + root.row-height - list.visible-height);
        }
        root.picked(row);
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            if event.text == Key.Return {
                root.accepted();
                return accept;
            }
            if event.text == Key.UpArrow {
                root.pick(root.current - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.pick(root.current + 1);
                return accept;
            }
            if event.text == Key.Home {
                root.pick(0);
                return accept;
            }
            if event.text == Key.End {
                root.pick(root.rows.length - 1);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 22px;
            spacing: 12px;

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: root.heading;
                    wrap: word-wrap;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.title;
                }

                Text {
                    text: root.hint;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.dim;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface-border;
                border-radius: 8px;
                clip: true;

                list := ScrollView {
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px;
                    height: parent.height - 10px;
                    content-width: self.visible-width;
                    content-height: root.rows.length * (root.row-height + root.row-gap);

                    for row[i] in root.rows: Rectangle {
                        property <bool> selected: i == root.current;
                        x: 0;
                        y: i * (root.row-height + root.row-gap);
                        width: list.visible-width;
                        height: root.row-height;
                        border-radius: 6px;
                        background: selected ? Theme.sel : row-touch.has-hover ? Theme.hover : transparent;

                        Text {
                            x: 12px;
                            y: 9px;
                            width: parent.width - 24px - kind.width - 10px;
                            text: row.title;
                            overflow: elide;
                            font-size: 13px;
                            font-weight: 600;
                            color: selected ? Theme.sel-text : Theme.list-text;
                        }

                        Text {
                            x: 12px;
                            y: 30px;
                            width: parent.width - 24px;
                            text: row.detail;
                            overflow: elide;
                            font-size: 12px;
                            color: selected ? Theme.sel-text : Theme.muted;
                        }

                        kind := Text {
                            x: parent.width - 12px - self.width;
                            y: 10px;
                            width: self.preferred-width;
                            text: row.kind;
                            font-size: 11px;
                            font-weight: 600;
                            color: selected ? Theme.sel-text : row.synced ? Theme.artist : Theme.muted;
                        }

                        row-touch := TouchArea {
                            clicked => {
                                root.pick(i);
                            }
                            double-clicked => {
                                root.accepted();
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                }

                PushButton {
                    min-width: 130px;
                    role: "primary";
                    text: "Use these lyrics";
                    clicked => {
                        root.accepted();
                    }
                }

                PushButton {
                    min-width: 90px;
                    text: "Cancel";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }

    // Bumped from Rust when the window comes back from the taskbar, as in main.slint:
    // changing this invisible full-window layer makes the next frame repaint every pixel.
    in property <int> repaint-count;
    Rectangle {
        background: Math.mod(root.repaint-count, 2) == 0 ? transparent : #00000001;
    }
}
