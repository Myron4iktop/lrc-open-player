// Small windows of the lyrics flow:
//
// - `DetailsDialog`: Ctrl+I, the Track Details window (`MetadataDialog`).
// - `QuestionDialog`: the offer to save lyrics found online (`_offer_to_save_online_lyrics`),
//   which needs its own button texts and a default button that a system message box
//   can't give.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PushButton } from "widgets.slint";

export struct DetailRow {
    label: string,
    value: string,
}

export component DetailsDialog inherits Window {
    title: "Track Details";
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 500px;
    preferred-height: 680px;
    min-width: 360px;
    min-height: 360px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <image> cover;
    in property <bool> has-cover;
    in property <[DetailRow]> rows;
    callback dismiss();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "Track Details";
                font-size: 18px;
                font-weight: 700;
                color: Theme.title;
            }

            if root.has-cover: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 140px;
                    height: 140px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                        image-fit: ImageFit.cover;
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    for row in root.rows: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            width: 110px;
                            text: row.label;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.dim;
                            vertical-alignment: top;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: row.value;
                            font-size: 13px;
                            color: Theme.text-soft;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                PushButton {
                    width: 90px;
                    text: "Close";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}

export component QuestionDialog inherits Window {
    in property <string> window-title <=> root.title;
    icon: @image-url("../../../../desktop/favicon.ico");
    preferred-width: 460px;
    min-width: 360px;
    background: Theme.dialog-bg;
    default-font-family: "Segoe UI";
    in property <string> question;
    in property <string> notes;
    in property <string> yes-text: "Yes";
    in property <string> no-text: "No";
    // Which button Enter presses: the safe one when something would be replaced.
    in property <bool> default-no;
    callback answered(bool);

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.answered(false);
                return accept;
            }
            if event.text == Key.Return {
                root.answered(!root.default-no);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 14px;
                // The question mark of QMessageBox.Icon.Question.
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.accent;
                    Text {
                        text: "?";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.question;
                        wrap: word-wrap;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    if root.notes != "": Text {
                        text: root.notes;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.text-soft;
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PushButton {
                    min-width: 90px;
                    text: root.yes-text;
                    clicked => {
                        root.answered(true);
                    }
                }

                PushButton {
                    min-width: 90px;
                    text: root.no-text;
                    clicked => {
                        root.answered(false);
                    }
                }
            }
        }
    }
}
