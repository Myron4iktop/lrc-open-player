<!DOCTYPE html>
<html lang="en">
<!-- Template for `cargo about generate` (see about.toml). The release workflow turns it
     into THIRD_PARTY_LICENSES.html, which ships next to LRCOpenPlayer.exe. -->
<head>
    <meta charset="utf-8">
    <title>LRC Open Player: third-party licenses</title>
    <style>
        body { font-family: "Segoe UI", sans-serif; background: #fff; color: #222; }
        a { color: #0b62c4; }
        @media (prefers-color-scheme: dark) {
            body { background: #1e1e1e; color: #eee; }
            a { color: #7cb8ff; }
        }
        .container { max-width: 860px; margin: 0 auto; padding: 0 16px; }
        .licenses-list { list-style-type: none; margin: 0; padding: 0; }
        .license-used-by { margin-top: -10px; }
        .license-text { max-height: 240px; overflow-y: auto; white-space: pre-wrap; }
    </style>
</head>

<body>
    <main class="container">
        <h1>LRC Open Player: third-party licenses</h1>
